# Proyecto de Supabase PROPIO de esta backend (NO el de ningún entorno
# cliente de Rendix). Acá vive solo staff_users.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominio de Google Workspace de Rendix, para restringir el selector de
# cuentas de Google al hacer login (parámetro "hd"). Ej: rendix.com.ar
NEXT_PUBLIC_STAFF_GOOGLE_WORKSPACE_DOMAIN=

# --- Credenciales de cada entorno CLIENTE de Rendix ---
# Se van completando a medida que se crean. Nunca llevan el prefijo
# NEXT_PUBLIC_: se usan solo server-side (rutas /api de esta backend) para
# dar de alta empresas/usuarios en el Supabase de cada entorno.
RENDIX_DEVELOPMENT_SUPABASE_URL=
RENDIX_DEVELOPMENT_SERVICE_ROLE_KEY=

RENDIX_TESTING_SUPABASE_URL=
RENDIX_TESTING_SERVICE_ROLE_KEY=

RENDIX_PRESALES_SUPABASE_URL=
RENDIX_PRESALES_SERVICE_ROLE_KEY=

RENDIX_PRODUCTION_SUPABASE_URL=
RENDIX_PRODUCTION_SERVICE_ROLE_KEY=

# --- Correo de bienvenida (altas por Google/Microsoft) ---
# Variables PROPIAS de esta backend: aunque rendi-platform también usa
# Resend, no comparte estas credenciales — hay que cargarlas acá aparte.
# Sin RESEND_API_KEY/EMAIL_FROM, el alta de usuarios sigue funcionando
# igual, solo que no se manda el mail (queda avisado en la respuesta).
RESEND_API_KEY=
EMAIL_FROM=
# Si se completa, TODOS los correos de bienvenida van a esta dirección en
# vez de a la real (para probar sin mandarle mails a un cliente de verdad).
EMAIL_TEST_RECIPIENT=
# URL de la app donde el cliente inicia sesión. Si se deja vacío, usa
# https://dev.rendixapp.com por defecto.
RENDIX_APP_URL=
